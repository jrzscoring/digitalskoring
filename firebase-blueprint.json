{
  "entities": {
    "Arena": {
      "title": "Arena",
      "description": "Gelanggang pertandingan Pencak Silat yang dikelola oleh Sekretaris/Panitia.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tournamentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "venue": { "type": "string", "maxLength": 120 },
        "eventDate": { "type": "string", "maxLength": 80 },
        "logoLeft": { "type": "string", "maxLength": 250000 },
        "logoRight": { "type": "string", "maxLength": 250000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "activeMatchId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "tournamentName", "ownerId", "activeMatchId", "createdAt", "updatedAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Partai pertandingan kategori Tanding sesuai peraturan IPSI 2026 & PERSILAT.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "arenaId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "matchNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "weightClass": { "type": "string", "minLength": 1, "maxLength": 80 },
        "stage": { "type": "string", "minLength": 1, "maxLength": 40 },
        "competitionCategory": { "type": "string", "enum": ["Tanding", "Jurus"] },
        "jurusType": { "type": "string", "enum": ["Tunggal Baku", "Ganda", "Regu", "Tunggal Bebas"] },
        "jurusJudgeCount": { "type": "integer", "minimum": 3, "maximum": 10 },
        "activePerformerCorner": { "type": "string", "enum": ["blue", "red"] },
        "jurusState": { "type": "object", "properties": {} },
        "blueName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "blueContingent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "blueCountry": { "type": "string", "maxLength": 64 },
        "bluePhoto": { "type": "string", "maxLength": 250000 },
        "redName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "redContingent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "redCountry": { "type": "string", "maxLength": 64 },
        "redPhoto": { "type": "string", "maxLength": 250000 },
        "roundDurationSec": { "type": "integer" },
        "currentRound": { "type": "integer" },
        "totalRounds": { "type": "integer" },
        "status": { "type": "string", "enum": ["waiting", "active", "paused", "break", "finished"] },
        "timerRemainingMs": { "type": "integer" },
        "timerStartedAtMs": { "type": "integer" },
        "blueScore": { "type": "integer" },
        "redScore": { "type": "integer" },
        "bluePunches": { "type": "integer" },
        "blueKicks": { "type": "integer" },
        "blueFalls": { "type": "integer" },
        "blueBinaan": { "type": "integer" },
        "blueTeguran1": { "type": "integer" },
        "blueTeguran2": { "type": "integer" },
        "bluePeringatan": { "type": "integer" },
        "redPunches": { "type": "integer" },
        "redKicks": { "type": "integer" },
        "redFalls": { "type": "integer" },
        "redBinaan": { "type": "integer" },
        "redTeguran1": { "type": "integer" },
        "redTeguran2": { "type": "integer" },
        "redPeringatan": { "type": "integer" },
        "judge1Vote": { "type": "object", "properties": {} },
        "judge2Vote": { "type": "object", "properties": {} },
        "judge3Vote": { "type": "object", "properties": {} },
        "verification": { "type": "object", "properties": {} },
        "juriLocked": { "type": "boolean" },
        "winner": { "type": "string", "enum": ["blue", "red", "draw", ""] },
        "winMethod": { "type": "string", "maxLength": 64 },
        "finishedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "arenaId", "ownerId", "matchNumber", "weightClass", "stage",
        "blueName", "blueContingent", "redName", "redContingent",
        "roundDurationSec", "currentRound", "status", "timerRemainingMs", "timerStartedAtMs",
        "blueScore", "redScore", "winner", "winMethod", "createdAt", "updatedAt"
      ]
    },
    "MatchEvent": {
      "title": "MatchEvent",
      "description": "Log kejadian penilaian juri, wasit, pelanggaran, dan pengesahan skor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "arenaId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "matchId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorRole": { "type": "string", "maxLength": 32 },
        "corner": { "type": "string", "enum": ["blue", "red", "neutral"] },
        "type": { "type": "string", "maxLength": 32 },
        "pointsDelta": { "type": "integer" },
        "round": { "type": "integer" },
        "matchTimeFormatted": { "type": "string", "maxLength": 16 },
        "description": { "type": "string", "maxLength": 200 },
        "undone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "arenaId", "matchId", "ownerId", "actorRole", "corner", "type", "pointsDelta", "round", "matchTimeFormatted", "description", "undone", "createdAt"]
    },
    "ArenaOperator": {
      "title": "ArenaOperator",
      "description": "Operator yang diizinkan mengakses gelanggang secara real-time.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "arenaId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["Sekretaris", "Dewan", "Timer", "Juri", "Scoreboard"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "arenaId", "ownerId", "role", "createdAt"]
    },
    "Athlete": {
      "title": "Athlete",
      "description": "Data registrasi atlet peserta kejuaraan Pencak Silat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "arenaId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "contingent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "country": { "type": "string", "maxLength": 64 },
        "photo": { "type": "string", "maxLength": 250000 },
        "weightClass": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gender": { "type": "string", "enum": ["Putra", "Putri"] },
        "ageCategory": { "type": "string", "enum": ["Usia Dini 1", "Usia Dini 2", "Usia Dini", "Pra Remaja", "Remaja", "Dewasa", "Master"] },
        "competitionCategory": { "type": "string", "enum": ["Tanding", "Jurus"] },
        "gelanggang": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "arenaId", "ownerId", "name", "contingent", "weightClass", "gender",
        "ageCategory", "competitionCategory", "gelanggang", "createdAt"
      ]
    },
    "BracketSlot": {
      "title": "BracketSlot",
      "description": "Slot bagan bracket pertandingan eliminasi (Prestasi & Pemasalan) per kelas dan kategori.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "arenaId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weightClass": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gender": { "type": "string", "enum": ["Putra", "Putri"] },
        "bracketMode": { "type": "string", "enum": ["prestasi", "pemasalan"] },
        "poolSize": { "type": "integer" },
        "poolIndex": { "type": "integer" },
        "poolLabel": { "type": "string", "maxLength": 40 },
        "ageCategory": { "type": "string", "maxLength": 32 },
        "competitionCategory": { "type": "string", "maxLength": 24 },
        "gelanggang": { "type": "string", "maxLength": 16 },
        "roundIndex": { "type": "integer" },
        "slotIndex": { "type": "integer" },
        "stage": { "type": "string", "minLength": 1, "maxLength": 40 },
        "blueName": { "type": "string", "maxLength": 80 },
        "blueContingent": { "type": "string", "maxLength": 80 },
        "redName": { "type": "string", "maxLength": 80 },
        "redContingent": { "type": "string", "maxLength": 80 },
        "matchId": { "type": "string", "maxLength": 64 },
        "winnerSide": { "type": "string", "enum": ["blue", "red", ""] },
        "winnerName": { "type": "string", "maxLength": 80 },
        "winnerContingent": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "arenaId", "ownerId", "weightClass", "gender", "roundIndex", "slotIndex",
        "stage", "blueName", "blueContingent", "redName", "redContingent", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/arenas/{arenaId}": {
      "schema": { "$ref": "#/entities/Arena" },
      "description": "Dokumen Gelanggang dan penunjuk partai aktif."
    },
    "/arenas/{arenaId}/operators/{operatorUid}": {
      "schema": { "$ref": "#/entities/ArenaOperator" },
      "description": "Daftar UID operator resmi pada gelanggang terkait."
    },
    "/arenas/{arenaId}/athletes/{athleteId}": {
      "schema": { "$ref": "#/entities/Athlete" },
      "description": "Daftar atlet yang diregistrasikan pada gelanggang."
    },
    "/arenas/{arenaId}/brackets/{slotId}": {
      "schema": { "$ref": "#/entities/BracketSlot" },
      "description": "Slot bagan bracket pertandingan eliminasi."
    },
    "/arenas/{arenaId}/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Data partai tanding beserta skor, timer, dan statistik teknik/pelanggaran."
    },
    "/arenas/{arenaId}/matches/{matchId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/MatchEvent" },
      "description": "Riwayat kejadian nilai dan pelanggaran dalam partai tanding."
    }
  }
}
