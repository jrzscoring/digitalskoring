rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUid(uid) {
      return uid is string && uid.size() >= 1 && uid.size() <= 128 && uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function arenaDoc(arenaId) {
      return get(/databases/$(database)/documents/arenas/$(arenaId));
    }

    function isArenaOwner(arenaId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/arenas/$(arenaId))
        && arenaDoc(arenaId).data.ownerId == request.auth.uid;
    }

    function isArenaOperator(arenaId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/arenas/$(arenaId)/operators/$(request.auth.uid));
    }

    function canAccessArena(arenaId) {
      return isArenaOwner(arenaId) || isArenaOperator(arenaId) || isAdmin();
    }

    // --- Validation Blueprints ---
    function isValidArena(data) {
      return data.keys().hasAll(['id', 'name', 'tournamentName', 'ownerId', 'activeMatchId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'tournamentName', 'venue', 'eventDate', 'logoLeft', 'logoRight',
          'ownerId', 'activeMatchId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.tournamentName is string && data.tournamentName.size() >= 1 && data.tournamentName.size() <= 120
        && (!('venue' in data) || (data.venue is string && data.venue.size() <= 120))
        && (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 80))
        && (!('logoLeft' in data) || (data.logoLeft is string && data.logoLeft.size() <= 250000))
        && (!('logoRight' in data) || (data.logoRight is string && data.logoRight.size() <= 250000))
        && isValidUid(data.ownerId)
        && data.activeMatchId is string && data.activeMatchId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOperator(data) {
      return data.keys().hasAll(['uid', 'arenaId', 'ownerId', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'arenaId', 'ownerId', 'role', 'createdAt'])
        && isValidUid(data.uid)
        && isValidId(data.arenaId)
        && isValidUid(data.ownerId)
        && data.role in ['Sekretaris', 'Dewan', 'Timer', 'Juri', 'Scoreboard']
        && data.createdAt is timestamp;
    }

    function isValidJudgeVote(vote) {
      return vote is map
        && vote.keys().hasAll(['corner', 'points', 'timestampMs', 'round'])
        && vote.keys().hasOnly(['corner', 'points', 'timestampMs', 'round', 'confirmed'])
        && vote.corner in ['blue', 'red', 'none']
        && vote.points is int && vote.points >= 0 && vote.points <= 3
        && vote.timestampMs is int && vote.timestampMs >= 0
        && vote.round is int && vote.round >= 1 && vote.round <= 3;
    }

    function isValidVerification(v) {
      return v is map
        && v.keys().hasAll(['active', 'kind', 'requestedAtMs', 'j1Vote', 'j2Vote', 'j3Vote'])
        && v.keys().hasOnly(['active', 'kind', 'requestedAtMs', 'j1Vote', 'j2Vote', 'j3Vote'])
        && v.active is bool
        && v.kind in ['jatuhan', 'pelanggaran']
        && v.requestedAtMs is int && v.requestedAtMs >= 0
        && v.j1Vote in ['none', 'blue', 'red', 'invalid']
        && v.j2Vote in ['none', 'blue', 'red', 'invalid']
        && v.j3Vote in ['none', 'blue', 'red', 'invalid'];
    }

    function isValidJurusJudgeCornerScore(js) {
      return js is map
        && js.keys().hasAll(['wrongMoves', 'staminaScore', 'attackScore', 'harmonyScore', 'soulScore', 'submitted'])
        && js.keys().hasOnly(['wrongMoves', 'staminaScore', 'attackScore', 'harmonyScore', 'soulScore', 'submitted'])
        && js.wrongMoves is int && js.wrongMoves >= 0 && js.wrongMoves <= 200
        && js.staminaScore is int && js.staminaScore >= 0 && js.staminaScore <= 10
        && js.attackScore is int && js.attackScore >= 0 && js.attackScore <= 30
        && js.harmonyScore is int && js.harmonyScore >= 0 && js.harmonyScore <= 30
        && js.soulScore is int && js.soulScore >= 0 && js.soulScore <= 30
        && js.submitted is bool;
    }

    function isValidJurusPenalties(p) {
      return p is map
        && p.keys().hasAll(['timeViolation', 'outOfBounds', 'weaponDrop', 'attireViolation', 'stopOrDelay'])
        && p.keys().hasOnly(['timeViolation', 'outOfBounds', 'weaponDrop', 'attireViolation', 'stopOrDelay'])
        && p.timeViolation is int && p.timeViolation >= 0 && p.timeViolation <= 20
        && p.outOfBounds is int && p.outOfBounds >= 0 && p.outOfBounds <= 20
        && p.weaponDrop is int && p.weaponDrop >= 0 && p.weaponDrop <= 20
        && p.attireViolation is int && p.attireViolation >= 0 && p.attireViolation <= 20
        && p.stopOrDelay is int && p.stopOrDelay >= 0 && p.stopOrDelay <= 20;
    }

    function isValidJurusCornerData(cd) {
      return cd is map
        && cd.keys().hasAll(['judge1', 'judge2', 'judge3', 'penalties', 'recordedElapsedMs', 'completed'])
        && cd.keys().hasOnly([
          'judge1', 'judge2', 'judge3', 'judge4', 'judge5',
          'judge6', 'judge7', 'judge8', 'judge9', 'judge10',
          'penalties', 'recordedElapsedMs', 'completed'
        ])
        && isValidJurusJudgeCornerScore(cd.judge1)
        && isValidJurusJudgeCornerScore(cd.judge2)
        && isValidJurusJudgeCornerScore(cd.judge3)
        && (!('judge4' in cd) || isValidJurusJudgeCornerScore(cd.judge4))
        && (!('judge5' in cd) || isValidJurusJudgeCornerScore(cd.judge5))
        && (!('judge6' in cd) || isValidJurusJudgeCornerScore(cd.judge6))
        && (!('judge7' in cd) || isValidJurusJudgeCornerScore(cd.judge7))
        && (!('judge8' in cd) || isValidJurusJudgeCornerScore(cd.judge8))
        && (!('judge9' in cd) || isValidJurusJudgeCornerScore(cd.judge9))
        && (!('judge10' in cd) || isValidJurusJudgeCornerScore(cd.judge10))
        && isValidJurusPenalties(cd.penalties)
        && cd.recordedElapsedMs is int && cd.recordedElapsedMs >= 0 && cd.recordedElapsedMs <= 600000
        && cd.completed is bool;
    }

    function isValidJurusState(js) {
      return js is map
        && js.keys().hasAll(['blue', 'red'])
        && js.keys().hasOnly(['blue', 'red'])
        && isValidJurusCornerData(js.blue)
        && isValidJurusCornerData(js.red);
    }

    function isValidMatchKeys(data) {
      return data.keys().hasAll([
          'id', 'arenaId', 'ownerId', 'matchNumber', 'weightClass', 'stage',
          'blueName', 'blueContingent', 'redName', 'redContingent',
          'roundDurationSec', 'currentRound', 'status', 'timerRemainingMs', 'timerStartedAtMs',
          'blueScore', 'redScore', 'bluePunches', 'blueKicks', 'blueFalls',
          'blueBinaan', 'blueTeguran1', 'blueTeguran2', 'bluePeringatan',
          'redPunches', 'redKicks', 'redFalls', 'redBinaan', 'redTeguran1',
          'redTeguran2', 'redPeringatan', 'winner', 'winMethod', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'arenaId', 'ownerId', 'matchNumber', 'weightClass', 'stage',
          'competitionCategory', 'jurusType', 'jurusJudgeCount', 'activePerformerCorner', 'jurusState',
          'blueName', 'blueContingent', 'blueCountry', 'bluePhoto',
          'redName', 'redContingent', 'redCountry', 'redPhoto',
          'roundDurationSec', 'currentRound', 'totalRounds', 'status', 'timerRemainingMs', 'timerStartedAtMs',
          'blueScore', 'redScore', 'bluePunches', 'blueKicks', 'blueFalls',
          'blueBinaan', 'blueTeguran1', 'blueTeguran2', 'bluePeringatan',
          'redPunches', 'redKicks', 'redFalls', 'redBinaan', 'redTeguran1',
          'redTeguran2', 'redPeringatan', 'judge1Vote', 'judge2Vote', 'judge3Vote', 'verification', 'juriLocked',
          'winner', 'winMethod', 'finishedAtMs', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidMatchMeta(data) {
      return isValidId(data.id)
        && isValidId(data.arenaId)
        && isValidUid(data.ownerId)
        && data.matchNumber is string && data.matchNumber.size() >= 1 && data.matchNumber.size() <= 32
        && data.weightClass is string && data.weightClass.size() >= 1 && data.weightClass.size() <= 80
        && data.stage is string && data.stage.size() >= 1 && data.stage.size() <= 40
        && (!('competitionCategory' in data) || data.competitionCategory in ['Tanding', 'Jurus'])
        && (!('jurusType' in data) || data.jurusType in ['Tunggal Baku', 'Ganda', 'Regu', 'Tunggal Bebas'])
        && (!('jurusJudgeCount' in data) || (data.jurusJudgeCount is int && data.jurusJudgeCount >= 3 && data.jurusJudgeCount <= 10))
        && (!('activePerformerCorner' in data) || data.activePerformerCorner in ['blue', 'red'])
        && (!('jurusState' in data) || isValidJurusState(data.jurusState))
        && data.blueName is string && data.blueName.size() >= 1 && data.blueName.size() <= 80
        && data.blueContingent is string && data.blueContingent.size() >= 1 && data.blueContingent.size() <= 80
        && (!('blueCountry' in data) || (data.blueCountry is string && data.blueCountry.size() <= 64))
        && (!('bluePhoto' in data) || (data.bluePhoto is string && data.bluePhoto.size() <= 250000))
        && data.redName is string && data.redName.size() >= 1 && data.redName.size() <= 80
        && data.redContingent is string && data.redContingent.size() >= 1 && data.redContingent.size() <= 80
        && (!('redCountry' in data) || (data.redCountry is string && data.redCountry.size() <= 64))
        && (!('redPhoto' in data) || (data.redPhoto is string && data.redPhoto.size() <= 250000));
    }

    function isValidMatchCounters(data) {
      return data.roundDurationSec is int && data.roundDurationSec >= 30 && data.roundDurationSec <= 300
        && data.currentRound is int && data.currentRound >= 1 && data.currentRound <= 3
        && (!('totalRounds' in data) || (data.totalRounds is int && data.totalRounds >= 1 && data.totalRounds <= 3))
        && data.status in ['waiting', 'active', 'paused', 'break', 'finished']
        && data.timerRemainingMs is int && data.timerRemainingMs >= 0 && data.timerRemainingMs <= 600000
        && data.timerStartedAtMs is int && data.timerStartedAtMs >= 0
        && data.blueScore is int && data.blueScore >= -100 && data.blueScore <= 1500
        && data.redScore is int && data.redScore >= -100 && data.redScore <= 1500
        && data.bluePunches is int && data.bluePunches >= 0 && data.bluePunches <= 999
        && data.blueKicks is int && data.blueKicks >= 0 && data.blueKicks <= 999
        && data.blueFalls is int && data.blueFalls >= 0 && data.blueFalls <= 99
        && data.blueBinaan is int && data.blueBinaan >= 0 && data.blueBinaan <= 20
        && data.blueTeguran1 is int && data.blueTeguran1 >= 0 && data.blueTeguran1 <= 20
        && data.blueTeguran2 is int && data.blueTeguran2 >= 0 && data.blueTeguran2 <= 20
        && data.bluePeringatan is int && data.bluePeringatan >= 0 && data.bluePeringatan <= 3
        && data.redPunches is int && data.redPunches >= 0 && data.redPunches <= 999
        && data.redKicks is int && data.redKicks >= 0 && data.redKicks <= 999
        && data.redFalls is int && data.redFalls >= 0 && data.redFalls <= 99
        && data.redBinaan is int && data.redBinaan >= 0 && data.redBinaan <= 20
        && data.redTeguran1 is int && data.redTeguran1 >= 0 && data.redTeguran1 <= 20
        && data.redTeguran2 is int && data.redTeguran2 >= 0 && data.redTeguran2 <= 20
        && data.redPeringatan is int && data.redPeringatan >= 0 && data.redPeringatan <= 3;
    }

    function isValidMatchState(data) {
      return (!('judge1Vote' in data) || isValidJudgeVote(data.judge1Vote))
        && (!('judge2Vote' in data) || isValidJudgeVote(data.judge2Vote))
        && (!('judge3Vote' in data) || isValidJudgeVote(data.judge3Vote))
        && (!('verification' in data) || isValidVerification(data.verification))
        && (!('juriLocked' in data) || data.juriLocked is bool)
        && data.winner in ['blue', 'red', 'draw', '']
        && data.winMethod is string && data.winMethod.size() <= 64
        && (!('finishedAtMs' in data) || (data.finishedAtMs is int && data.finishedAtMs >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatch(data) {
      return isValidMatchKeys(data)
        && isValidMatchMeta(data)
        && isValidMatchCounters(data)
        && isValidMatchState(data);
    }

    function isValidMatchEvent(data) {
      return data.keys().hasAll([
          'id', 'arenaId', 'matchId', 'ownerId', 'actorRole', 'corner',
          'type', 'pointsDelta', 'round', 'matchTimeFormatted', 'description', 'undone', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'arenaId', 'matchId', 'ownerId', 'actorRole', 'corner',
          'type', 'pointsDelta', 'round', 'matchTimeFormatted', 'description', 'undone', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.arenaId)
        && isValidId(data.matchId)
        && isValidUid(data.ownerId)
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 32
        && data.corner in ['blue', 'red', 'neutral']
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 32
        && data.pointsDelta is int && data.pointsDelta >= -500 && data.pointsDelta <= 500
        && data.round is int && data.round >= 1 && data.round <= 3
        && data.matchTimeFormatted is string && data.matchTimeFormatted.size() >= 1 && data.matchTimeFormatted.size() <= 16
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && data.undone is bool
        && data.createdAt is timestamp;
    }

    function isValidAthlete(data) {
      return data.keys().hasAll([
          'id', 'arenaId', 'ownerId', 'name', 'contingent', 'weightClass', 'gender',
          'ageCategory', 'competitionCategory', 'gelanggang', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'arenaId', 'ownerId', 'name', 'contingent', 'country', 'photo',
          'weightClass', 'gender', 'ageCategory', 'competitionCategory', 'gelanggang', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.arenaId)
        && isValidUid(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.contingent is string && data.contingent.size() >= 1 && data.contingent.size() <= 80
        && (!('country' in data) || (data.country is string && data.country.size() <= 64))
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 250000))
        && data.weightClass is string && data.weightClass.size() >= 1 && data.weightClass.size() <= 80
        && data.gender in ['Putra', 'Putri']
        && data.ageCategory in ['Usia Dini 1', 'Usia Dini 2', 'Usia Dini', 'Pra Remaja', 'Remaja', 'Dewasa', 'Master']
        && data.competitionCategory in ['Tanding', 'Jurus']
        && data.gelanggang in ['A', 'B', 'C', 'D']
        && data.createdAt is timestamp;
    }

    function isValidBracketSlot(data) {
      return data.keys().hasAll([
          'id', 'arenaId', 'ownerId', 'weightClass', 'gender', 'roundIndex', 'slotIndex',
          'stage', 'blueName', 'blueContingent', 'redName', 'redContingent', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'arenaId', 'ownerId', 'weightClass', 'gender',
          'bracketMode', 'poolSize', 'poolIndex', 'poolLabel',
          'ageCategory', 'competitionCategory', 'gelanggang',
          'roundIndex', 'slotIndex',
          'stage', 'blueName', 'blueContingent', 'redName', 'redContingent',
          'matchId', 'winnerSide', 'winnerName', 'winnerContingent', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.arenaId)
        && isValidUid(data.ownerId)
        && data.weightClass is string && data.weightClass.size() >= 1 && data.weightClass.size() <= 80
        && data.gender in ['Putra', 'Putri']
        && (!('bracketMode' in data) || data.bracketMode in ['prestasi', 'pemasalan'])
        && (!('poolSize' in data) || (data.poolSize is int && data.poolSize >= 0 && data.poolSize <= 64))
        && (!('poolIndex' in data) || (data.poolIndex is int && data.poolIndex >= 0 && data.poolIndex <= 128))
        && (!('poolLabel' in data) || (data.poolLabel is string && data.poolLabel.size() <= 40))
        && (!('ageCategory' in data) || (data.ageCategory is string && data.ageCategory.size() <= 32))
        && (!('competitionCategory' in data) || (data.competitionCategory is string && data.competitionCategory.size() <= 24))
        && (!('gelanggang' in data) || (data.gelanggang is string && data.gelanggang.size() <= 16))
        && data.roundIndex is int && data.roundIndex >= 0 && data.roundIndex <= 8
        && data.slotIndex is int && data.slotIndex >= 0 && data.slotIndex <= 64
        && data.stage is string && data.stage.size() >= 1 && data.stage.size() <= 40
        && data.blueName is string && data.blueName.size() <= 80
        && data.blueContingent is string && data.blueContingent.size() <= 80
        && data.redName is string && data.redName.size() <= 80
        && data.redContingent is string && data.redContingent.size() <= 80
        && (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 64))
        && (!('winnerSide' in data) || data.winnerSide in ['blue', 'red', ''])
        && (!('winnerName' in data) || (data.winnerName is string && data.winnerName.size() <= 80))
        && (!('winnerContingent' in data) || (data.winnerContingent is string && data.winnerContingent.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && request.auth.uid == adminUid;
    }

    match /arenas/{arenaId} {
      allow get: if isValidId(arenaId) && isVerifiedUser() && (
        existing().ownerId == request.auth.uid || isArenaOperator(arenaId) || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(arenaId) && isVerifiedUser()
        && isValidArena(incoming())
        && incoming().id == arenaId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(arenaId) && isVerifiedUser()
        && isValidArena(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().ownerId == request.auth.uid || isAdmin())
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'tournamentName', 'venue', 'eventDate', 'logoLeft', 'logoRight', 'activeMatchId', 'updatedAt'
          ])
        );
      allow delete: if isValidId(arenaId) && isVerifiedUser() && (
        existing().ownerId == request.auth.uid || isAdmin()
      );

      match /operators/{operatorUid} {
        allow get: if isValidId(arenaId) && isValidUid(operatorUid) && isVerifiedUser() && (
          request.auth.uid == operatorUid || isArenaOwner(arenaId) || isAdmin()
        );
        allow list: if isVerifiedUser() && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(arenaId) && isValidUid(operatorUid) && isVerifiedUser()
          && isValidOperator(incoming())
          && incoming().uid == operatorUid
          && incoming().arenaId == arenaId
          && incoming().createdAt == request.time
          && isArenaOwner(arenaId)
          && incoming().ownerId == arenaDoc(arenaId).data.ownerId;
        allow delete: if isValidId(arenaId) && isValidUid(operatorUid) && isVerifiedUser() && (
          isArenaOwner(arenaId) || isAdmin()
        );
      }

      match /athletes/{athleteId} {
        allow get: if isValidId(arenaId) && isValidId(athleteId) && canAccessArena(arenaId);
        allow list: if isVerifiedUser() && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(arenaId) && isValidId(athleteId) && isVerifiedUser()
          && isValidAthlete(incoming())
          && incoming().id == athleteId
          && incoming().arenaId == arenaId
          && incoming().createdAt == request.time
          && isArenaOwner(arenaId)
          && incoming().ownerId == request.auth.uid;
        allow update: if isValidId(arenaId) && isValidId(athleteId) && isVerifiedUser()
          && isValidAthlete(incoming())
          && incoming().id == existing().id
          && incoming().arenaId == existing().arenaId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (isArenaOwner(arenaId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'contingent', 'country', 'photo', 'weightClass',
            'gender', 'ageCategory', 'competitionCategory', 'gelanggang'
          ]);
        allow delete: if isValidId(arenaId) && isValidId(athleteId) && isVerifiedUser() && (
          isArenaOwner(arenaId) || isAdmin()
        );
      }

      match /brackets/{slotId} {
        allow get: if isValidId(arenaId) && isValidId(slotId) && canAccessArena(arenaId);
        allow list: if isVerifiedUser() && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(arenaId) && isValidId(slotId) && isVerifiedUser()
          && isValidBracketSlot(incoming())
          && incoming().id == slotId
          && incoming().arenaId == arenaId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isArenaOwner(arenaId)
          && incoming().ownerId == request.auth.uid;
        allow update: if isValidId(arenaId) && isValidId(slotId) && isVerifiedUser()
          && isValidBracketSlot(incoming())
          && incoming().id == existing().id
          && incoming().arenaId == existing().arenaId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && canAccessArena(arenaId)
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'blueName', 'blueContingent', 'redName', 'redContingent',
              'matchId', 'winnerSide', 'winnerName', 'winnerContingent', 'updatedAt'
            ])
          );
        allow delete: if isValidId(arenaId) && isValidId(slotId) && isVerifiedUser() && (
          isArenaOwner(arenaId) || isAdmin()
        );
      }

      match /matches/{matchId} {
        allow get: if isValidId(arenaId) && isValidId(matchId) && canAccessArena(arenaId);
        allow list: if isVerifiedUser() && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(arenaId) && isValidId(matchId) && isVerifiedUser()
          && isValidMatch(incoming())
          && incoming().id == matchId
          && incoming().arenaId == arenaId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isArenaOwner(arenaId)
          && incoming().ownerId == request.auth.uid;
        allow update: if isValidId(arenaId) && isValidId(matchId) && isVerifiedUser()
          && isValidMatch(incoming())
          && incoming().id == existing().id
          && incoming().arenaId == existing().arenaId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (isArenaOwner(arenaId) || (existing().status != 'finished' && isArenaOperator(arenaId))) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'matchNumber', 'weightClass', 'stage', 'competitionCategory', 'jurusType', 'jurusJudgeCount',
                'activePerformerCorner', 'jurusState', 'blueName', 'blueContingent', 'blueCountry', 'bluePhoto',
                'redName', 'redContingent', 'redCountry', 'redPhoto',
                'roundDurationSec', 'currentRound', 'totalRounds', 'status',
                'timerRemainingMs', 'timerStartedAtMs', 'juriLocked',
                'blueScore', 'redScore', 'bluePunches', 'redPunches', 'blueKicks', 'redKicks',
                'blueFalls', 'redFalls', 'blueBinaan', 'redBinaan',
                'blueTeguran1', 'redTeguran1', 'blueTeguran2', 'redTeguran2',
                'bluePeringatan', 'redPeringatan', 'judge1Vote', 'judge2Vote', 'judge3Vote',
                'verification', 'winner', 'winMethod', 'finishedAtMs', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(arenaId) && isValidId(matchId) && isVerifiedUser() && (
          isArenaOwner(arenaId) || isAdmin()
        );

        match /events/{eventId} {
          allow get: if isValidId(arenaId) && isValidId(matchId) && isValidId(eventId) && canAccessArena(arenaId);
          allow list: if isVerifiedUser() && (
            resource.data.ownerId == request.auth.uid || isAdmin()
          );
          allow create: if isValidId(arenaId) && isValidId(matchId) && isValidId(eventId) && isVerifiedUser()
            && isValidMatchEvent(incoming())
            && incoming().id == eventId
            && incoming().arenaId == arenaId
            && incoming().matchId == matchId
            && incoming().createdAt == request.time
            && canAccessArena(arenaId)
            && exists(/databases/$(database)/documents/arenas/$(arenaId)/matches/$(matchId))
            && incoming().ownerId == arenaDoc(arenaId).data.ownerId;
          allow update: if isValidId(arenaId) && isValidId(matchId) && isValidId(eventId) && isVerifiedUser()
            && isValidMatchEvent(incoming())
            && incoming().id == existing().id
            && incoming().arenaId == existing().arenaId
            && incoming().matchId == existing().matchId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && canAccessArena(arenaId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['undone']);
          allow delete: if isValidId(arenaId) && isValidId(matchId) && isValidId(eventId) && isVerifiedUser() && (
            isArenaOwner(arenaId) || isAdmin()
          );
        }
      }
    }
  }
}
